FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
RUN python -m pip install --no-cache-dir pytest==9.1.1
# Only pure modules are needed; do not copy API keys or saved user data.
COPY logic_manager.py ai_handler_manager.py ./
COPY test_logic_manager.py ./
CMD ["python", "-m", "pytest", "-q", "-p", "no:cacheprovider", "test_logic_manager.py"]
